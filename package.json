{
  "name": "@endevops/device-detector-js",
  "version": "3.0.3",
  "description": "A javascript port of Matomo device-detector",
  "keywords": [
    "bot",
    "browser",
    "desktop",
    "detector",
    "device",
    "mobile",
    "os",
    "parser",
    "parsing",
    "phone",
    "tablet",
    "user-agent"
  ],
  "homepage": "https://github.com/Endevops/device-detector-js#readme",
  "bugs": {
    "url": "https://github.com/Endevops/device-detector-js/issues"
  },
  "license": "LGPL-3.0",
  "author": {
    "name": "Etienne Martin",
    "url": "http://etiennemartin.ca/"
  },
  "contributors": [
    "Etienne Martin <github@emartin.ca> (http://etiennemartin.ca/)",
    "Alex Beauchemin <alexbeauchemin01@gmail.com> (https://github.com/AlexBeauchemin)",
    "Ayan Dey <ayand04@gmail.com> (https://github.com/whimsicaldreamer)",
    "Julien Maitrehenry <julien.maitrehenry@me.com> (https://github.com/jmaitrehenry)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/device-detector-js.git"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fixtures": "sh load-fixtures.sh",
    "fmt": "oxfmt",
    "lint": "oxlint . --type-aware --type-check",
    "lint:fix": "oxlint . --type-aware --type-check --fix --fix-suggestions",
    "predev": "bun run fixtures",
    "prepublish": "tsdown",
    "pretest": "bun run build",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.4",
    "@types/bun": "^1.3.14",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.1",
    "napa": "^3.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.5.7"
  },
  "engines": {
    "node": ">= 24"
  },
  "napa": {
    "device-detector": "https://github.com/matomo-org/device-detector#6.5.1"
  },
  "napa-config": {
    "cache": false
  }
}
